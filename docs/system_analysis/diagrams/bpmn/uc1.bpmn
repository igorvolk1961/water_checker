<bpmn:collaboration id="Collab_uc1">
<bpmn:participant id="P_uc1_1C" name="«БИТ:LIMS» (1С)" processRef="Proc_uc1_1C"/>
<bpmn:participant id="P_uc1_AquaPredict" name="AquaPredict" processRef="Proc_uc1_AquaPredict"/>
<bpmn:participant id="P_uc1_Line" name="Линия/шлюз (внешнее)" processRef="Proc_uc1_Line"/>
<bpmn:messageFlow id="mf_uc1_1" sourceRef="n1" targetRef="n2" name="межсистемное взаимодействие"/>
<bpmn:messageFlow id="mf_uc1_3" sourceRef="n3" targetRef="n4" name="межсистемное взаимодействие"/>
<bpmn:messageFlow id="mf_uc1_4" sourceRef="n4" targetRef="n5" name="межсистемное взаимодействие"/>
