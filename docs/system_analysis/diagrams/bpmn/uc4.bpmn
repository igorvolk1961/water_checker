<bpmn:collaboration id="Collab_uc4">
<bpmn:participant id="P_uc4_AquaPredict" name="AquaPredict" processRef="Proc_uc4_AquaPredict"/>
<bpmn:participant id="P_uc4_1C" name="«БИТ:LIMS» (1С)" processRef="Proc_uc4_1C"/>
<bpmn:messageFlow id="mf_uc4_2" sourceRef="n2" targetRef="n3" name="межсистемное взаимодействие"/>
<bpmn:messageFlow id="mf_uc4_3" sourceRef="n3" targetRef="n4" name="межсистемное взаимодействие"/>
<bpmn:messageFlow id="mf_uc4_7" sourceRef="n7" targetRef="n8" name="межсистемное взаимодействие"/>
<bpmn:messageFlow id="mf_uc4_8" sourceRef="n8" targetRef="n9" name="межсистемное взаимодействие"/>
</bpmn:collaboration>
<bpmn:process id="Proc_uc4_AquaPredict" isExecutable="false">
<bpmn:laneSet id="ls_uc4">
<bpmn:lane id="lane_uc4_0" name="Система (AquaPredict)"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>n7</bpmn:flowNodeRef><bpmn:flowNodeRef>n9</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_uc4_1" name="Лаборант"><bpmn:flowNodeRef>n4</bpmn:flowNodeRef><bpmn:flowNodeRef>n5</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="n1" name="Вход: высокий риск отклонения (из UC2; например, рост мутности TEL-06)"/>
<bpmn:serviceTask id="n2" name="Генерация задания «Внеплановый отбор пробы» для конкретной партии, приоритет «Срочно»; запись в 1С через HTTP-сервис (FR"/>
<bpmn:userTask id="n4" name="Физический отбор пробы у линии: стерильная тара, маркировка (вне систем)"/>
<bpmn:userTask id="n5" name="Сканирование штрихкода пробы в 1С — подтверждение факта отбора; далее — стандартный лабораторный анализ (Chain of Custod"/>
<bpmn:serviceTask id="n6" name="Чтение статуса задания и пробы по OData; сохранение ссылки «инцидент → задание → проба»"/>
<bpmn:serviceTask id="n7" name="Автоматическая связка «проба → срез телеметрии за окно (2 ч)» — Feature Vector + лабораторный результат как метка"/>
<bpmn:endEvent id="n9" name="Результат в связке «инцидент → проба»: True Positive / False Positive → пополнение обучающей выборки (FR-11, UC6)"/>
<bpmn:sequenceFlow id="sf_uc4_1" sourceRef="n1" targetRef="n2"/>
<bpmn:sequenceFlow id="sf_uc4_4" sourceRef="n4" targetRef="n5"/>
<bpmn:sequenceFlow id="sf_uc4_5" sourceRef="n5" targetRef="n6"/>
<bpmn:sequenceFlow id="sf_uc4_6" sourceRef="n6" targetRef="n7"/>
</bpmn:process>
<bpmn:process id="Proc_uc4_1C" isExecutable="false">
<bpmn:task id="n3" name="Задание в модуле отбора; уведомление лаборанту штатными средствами 1С (канал — открытый вопрос 2)"/>
<bpmn:task id="n8" name="Лабораторный анализ, протокол испытаний (ground truth)"/>
</bpmn:process>
