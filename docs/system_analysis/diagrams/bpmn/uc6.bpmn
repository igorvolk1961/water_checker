</bpmn:laneSet>
<bpmn:serviceTask id="n1" name="Автоагрегация: связка «срез телеметрии за окно (2 ч) → лабораторный протокол или вердикт технолога» → «Размеченный приме"/>
<bpmn:serviceTask id="n2" name="Приоритет метки: лабораторный протокол &gt; вердикт технолога (прокси-метка)"/>
<bpmn:exclusiveGateway id="n3" name="Источники расходятся или противоречат объективным данным?"/>
<bpmn:serviceTask id="n4" name="Накоплено N новых примеров → уведомление DS: «Накоплено 500 новых размеченных примеров» (SCR-07)"/>
<bpmn:userTask id="n5" name="Инициирует переобучение (Retraining) на расширенном датасете"/>
<bpmn:serviceTask id="n6" name="Пайплайн обучения; вычисление метрик новой версии (Recall/Precision/FPR/F1 — цели по слоям `kpi.md` §2)"/>
<bpmn:exclusiveGateway id="n7" name="Метрики новой версии ≥ рабочей (допустимый коридор)?"/>
<bpmn:userTask id="n8" name="«Утвердить и развернуть»"/>
<bpmn:endEvent id="n9" name="Новая версия → [Production]; старая → [Архив]; журнал версий в SCR-07"/>
