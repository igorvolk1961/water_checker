<bpmn:startEvent id="n1" name="Вход: подтверждённый инцидент (из UC2, шаг 9) — задача на корректирующее действие уже создана в 1С с рекомендованными ша"/>
<bpmn:userTask id="n3" name="Физическое выполнение действия на оборудовании (вне систем)"/>
<bpmn:userTask id="n4" name="Закрытие задачи в 1С: «Действие выполнено» + приложение (фото/комментарий)"/>
<bpmn:serviceTask id="n6" name="Чтение статуса по OData; синхронизация в карточку инцидента (SCR-02); различение источника события в аудите"/>
<bpmn:exclusiveGateway id="n7" name="Результат корректирующего действия [Выполнено]?"/>
<bpmn:userTask id="n8" name="Фиксация **вердикта по инциденту** — отдельная сущность: [Подтверждён / Ложное срабатывание] + причина (не смешивать с р"/>
<bpmn:serviceTask id="n9" name="Вердикт → прокси-метка в обучающую выборку (FR-11; приоритет — лабораторный протокол); инцидент [Закрыт]; блокировка зак"/>
