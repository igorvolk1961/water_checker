<bpmn:participant id="P_uc2_AquaPredict" name="AquaPredict" processRef="Proc_uc2_AquaPredict"/>
<bpmn:participant id="P_uc2_1C" name="«БИТ:LIMS» (1С)" processRef="Proc_uc2_1C"/>
<bpmn:messageFlow id="mf_uc2_9" sourceRef="n9" targetRef="n10" name="межсистемное взаимодействие"/>
<bpmn:messageFlow id="mf_uc2_10" sourceRef="n10" targetRef="n11" name="межсистемное взаимодействие"/>
</bpmn:collaboration>
<bpmn:process id="Proc_uc2_AquaPredict" isExecutable="false">
<bpmn:laneSet id="ls_uc2">
<bpmn:lane id="lane_uc2_0" name="Система (AquaPredict)"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>n3</bpmn:flowNodeRef><bpmn:flowNodeRef>n4</bpmn:flowNodeRef><bpmn:flowNodeRef>n5</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>n9</bpmn:flowNodeRef><bpmn:flowNodeRef>n11</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_uc2_1" name="Главный технолог (ГТ)"><bpmn:flowNodeRef>n7</bpmn:flowNodeRef><bpmn:flowNodeRef>n8</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:serviceTask id="n1" name="Телеметрия по партии связана и анализируется (FR-01, FR-02; TEL-01…TEL-13)"/>
<bpmn:serviceTask id="n2" name="Расчёт вероятности риска (Слой 1 правила / Слой 2 ML; FR-03/FR-04)"/>
<bpmn:exclusiveGateway id="n3" name="Вероятность ≥ рабочей точки?"/>
<bpmn:serviceTask id="n4" name="Генерация события `RiskAlert` (партия, параметр, риск-скор, горизонт, рекомендация) ≤ 5 с от датчика"/>
<bpmn:exclusiveGateway id="n5" name="Алертов за час &lt; 10?"/>
<bpmn:serviceTask id="n6" name="Создание записи «Предиктивный инцидент» [Новый]; уведомление ГТ (push/SMS — SCR-12); критический уровень → выделение, зв"/>
<bpmn:userTask id="n7" name="Получение алерта, подтверждение ознакомления; просмотр карточки инцидента (SCR-02): тренды, рекомендация"/>
<bpmn:exclusiveGateway id="n8" name="Риск реален?"/>
<bpmn:serviceTask id="n9" name="Создание задачи «Корректирующее действие» в 1С через HTTP-сервис с рекомендованными шагами; при высоком риске — параллел"/>
<bpmn:serviceTask id="n11" name="Статусы синхронизируются обратно (≤ 60 запросов/мин, NFR-6); инцидент [Подтверждён]"/>
<bpmn:sequenceFlow id="sf_uc2_1" sourceRef="n1" targetRef="n2"/>
<bpmn:sequenceFlow id="sf_uc2_2" sourceRef="n2" targetRef="n3"/>
<bpmn:sequenceFlow id="sf_uc2_3" sourceRef="n3" targetRef="n4"/>
