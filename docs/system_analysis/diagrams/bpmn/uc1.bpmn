<bpmn:messageFlow id="mf_uc1_7" sourceRef="n7" targetRef="n8" name="межсистемное взаимодействие"/>
</bpmn:collaboration>
<bpmn:process id="Proc_uc1_1C" isExecutable="false">
<bpmn:startEvent id="n1" name="Регистрация производственной партии (штатный процесс 1С, номер партии — источник прослеживаемости)"/>
<bpmn:intermediateThrowEvent id="n7" name="Попытка закрытия партии"/>
</bpmn:process>
<bpmn:process id="Proc_uc1_AquaPredict" isExecutable="false">
<bpmn:laneSet id="ls_uc1">
<bpmn:lane id="lane_uc1_0" name="Система (AquaPredict)"><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>n3</bpmn:flowNodeRef><bpmn:flowNodeRef>n5</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>n8</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:serviceTask id="n2" name="Чтение новой партии по OData (в составе пакета, ≤ 60 запросов/мин — NFR-6)"/>
<bpmn:serviceTask id="n3" name="Регистрация начала наблюдения за партией; привязка временных рядов телеметрии к идентификатору партии"/>
<bpmn:serviceTask id="n5" name="Контроль качества потока: пропуски, «замороженные» значения, выход за физический диапазон → события для инженера КИПиА ("/>
<bpmn:endEvent id="n6" name="Партия наблюдается: скоринг запущен (UC2)"/>
<bpmn:exclusiveGateway id="n8" name="Есть непроверенные предиктивные инциденты по партии?"/>
<bpmn:sequenceFlow id="sf_uc1_2" sourceRef="n2" targetRef="n3"/>
<bpmn:sequenceFlow id="sf_uc1_5" sourceRef="n5" targetRef="n6"/>
</bpmn:process>
<bpmn:process id="Proc_uc1_Line" isExecutable="false">
<bpmn:task id="n4" name="Поток телеметрии TEL-01…TEL-13 по OPC-UA / MQTT, частота ≥ 1 раз/мин; буферизация до 2 ч при потере связи с автосинхрони"/>
</bpmn:process>
