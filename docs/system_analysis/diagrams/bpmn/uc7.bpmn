</bpmn:laneSet>
<bpmn:startEvent id="n1" name="Вход: доступны архивные логи SCADA-Historian (CSV / OPC-UA HDA) и оцифрованные лабораторные журналы"/>
<bpmn:serviceTask id="n2" name="Импорт архива (ETL): очистка, валидация форматов"/>
<bpmn:exclusiveGateway id="n3" name="Архивных данных достаточно?"/>
<bpmn:serviceTask id="n4" name="Матчинг: срез телеметрии за окно (2 ч) до отбора пробы → проба из журнала; отчёт о качестве матчинга (доля ≥ 90 % — `kpi"/>
<bpmn:serviceTask id="n5" name="Обучение Baseline-профиля (Anomaly Detection, без размеченных примеров брака)"/>
<bpmn:userTask id="n6" name="Проверка профиля; размещение в Shadow Mode"/>
<bpmn:serviceTask id="n7" name="Shadow Mode: прогнозы не показываются персоналу, накапливаются метрики точности"/>
<bpmn:userTask id="n8" name="Подтверждение профиля нормы как «Эталонный» (ST-06)"/>
<bpmn:exclusiveGateway id="n9" name="Критерии перехода §4 выполнены (Recall ≥ 0,75 при FPR ≤ 0,10; ≥ 4 недель стабильности; ≥ N подтверждённых инцидентов)?"/>
<bpmn:endEvent id="n10" name="Переключение в режим советника (Advisor) — конец калибровки"/>
